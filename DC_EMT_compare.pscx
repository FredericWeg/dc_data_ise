        <User classid="UserCmp" id="1615289302" name="DC_EMT_lib:Voltage_Dip_Generator" x="414" y="2934" w="137" h="78" z="410" orient="0" defn="DC_EMT_lib:Voltage_Dip_Generator" link="-1" q="4" disable="false">
          <paramlist name="" link="-1" crc="112441818">
            <param name="t_dip" value="5" />
            <param name="t_clear" value="5.5" />
            <param name="V_set" value="1" />
